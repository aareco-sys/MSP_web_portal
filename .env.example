# ── ClickUp ──────────────────────────────────────────────────────────────────
# Token personal de ClickUp (pk_...). NUNCA commitear el valor real.
# En prod se inyecta desde AWS Secrets Manager.
CLICKUP_TOKEN=

# IDs del workspace MSP (tienen default en el código; override opcional).
CLICKUP_TEAM_ID=3016250
CLICKUP_SPACE_ID=90020465072
# Carpetas de clientes activos (Latam, US). Coma-separadas.
CLICKUP_ACTIVE_FOLDER_IDS=90021032350,90179149892

# Concurrencia de llamadas a la API (subir acelera, bajar evita 429).
CLICKUP_CONCURRENCY=16

# ── Caché / datos ──────────────────────────────────────────────────────────────
# TTL de la caché en memoria (segundos). Default 30 min.
MSP_CACHE_TTL=1800
# Días hacia atrás a traer (para comparación mensual). Default ~13 meses.
MSP_LOOKBACK_DAYS=400

# ── Auth (solo prod — fase de deploy) ───────────────────────────────────────────
# AUTH_SECRET=
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
# COGNITO_ISSUER=

# ── Google Sheets (fichas técnicas / matriz de skills) ──────────────────────────
# Ver docs/google-sheets-setup.md para el paso a paso completo.
# NUNCA commitear estos valores reales. En prod se inyectan desde AWS Secrets Manager.
#
# ID de la spreadsheet (de la URL: /spreadsheets/d/<ID>/edit).
GOOGLE_SHEETS_SPREADSHEET_ID=
# Email del service account de GCP (termina en .iam.gserviceaccount.com).
# Debe tener acceso de Viewer sobre la spreadsheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key del service account (bloque PEM). En .env va entre comillas con
# los saltos de línea escapados como \n; en Secrets Manager va tal cual.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Rango A1 de la hoja con la matriz de skills (hoja + columnas).
GOOGLE_SHEETS_SKILLS_RANGE=Hoja 1!A:I

# TTL de la caché en memoria de la matriz de skills (segundos). Default 30 min.
SKILLS_CACHE_TTL=1800
